<mxfile host="app.diagrams.net">
  <diagram name="BluePeak AWS Architecture" id="bluepeak-arch">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Internet -->
        <mxCell id="internet" value="Internet Users" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="700" y="20" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Route53 -->
        <mxCell id="r53" value="Route 53 (DNS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- WAF -->
        <mxCell id="waf" value="AWS WAF (managed rules + rate limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="660" y="180" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- VPC boundary -->
        <mxCell id="vpc" value="VPC 10.20.0.0/16" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#000000;dashed=1" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="1360" height="700" as="geometry" />
        </mxCell>

        <!-- Public tier -->
        <mxCell id="pub" value="Public Subnets (2 AZs)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="160" y="290" width="1280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="alb" value="Application Load Balancer\n(internet-facing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="700" y="330" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nat1" value="NAT Gateway AZ-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nat2" value="NAT Gateway AZ-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="1180" y="330" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- App tier -->
        <mxCell id="appTier" value="Private App Subnets (2 AZs) - ECS Fargate" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="160" y="460" width="1280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ecs1" value="Fargate Task\n(counter app AZ-a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ecs2" value="Fargate Task\n(counter app AZ-b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="900" y="510" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="asg" value="Application Auto Scaling\n(CPU + ALB RequestCount target tracking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="500" y="580" width="580" height="30" as="geometry" />
        </mxCell>

        <!-- Data tier -->
        <mxCell id="dbTier" value="Private DB Subnets (2 AZs) - Aurora PostgreSQL Serverless v2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="160" y="650" width="1280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rdsW" value="Aurora Writer\nInstance (AZ-a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="695" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rdsR" value="Aurora Reader\nInstance (AZ-b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="820" y="695" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Supporting services -->
        <mxCell id="secrets" value="Secrets Manager\n(DB credentials)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="695" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ecr" value="ECR\n(container images)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="200" y="695" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cw" value="CloudWatch\n(dashboards, alarms, logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="200" y="850" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sns" value="SNS\n(alerting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="420" y="850" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kms" value="KMS\n(encryption at rest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="600" y="850" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="internet" target="r53"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r53" target="waf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="waf" target="alb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="alb" target="ecs1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="alb" target="ecs2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ecs1" target="rdsW"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ecs2" target="rdsW"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="rdsW" target="rdsR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ecs1" target="nat1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ecs2" target="nat2"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
